ranaries": "Elevated structures for millet/sorghum storage",\n      "fortifications": "Fortified walls, trenches around homesteads/villages; defensive against cattle raiding; abolished 1913"\n    },\n    "cuisine": {\n      "precolonial_diet": "Meat, milk, blood (livestock); millet, sorghum cereals; fruits, vegetables; birds, chintuga (edible insects); wild game",\n      "staple": "Obokima (hardened dough of millet/sorghum flour, water); served with green vegetables: rinagu, chinsaga, rikuneni, enderema, emboga, omotere, risosa, egesare; milk (especially sour milk)",\n      "maize_introduction": "1920s; maize flour now primary obokima ingredient",\n      "snack": "Ritoke (amatoke, cooked flavored bananas); supplemental, not proper meal",\n      "cultural_linguistic": "\'Ragera\' (having a meal) connotes obokima at center"\n    },\n    "music_and_art": {\n      "obokano": "Eight-stringed bass lyre; largest such lyre in Kenya; up to six feet tall; reserved for men; used to accompany singing/dancing; solo as vocal introduction",\n      "other_instruments": "Ekonu (drums, women during circumcision ceremonies); rattles; flutes",\n      "vocal_music": "Primarily vocal; obokano accompaniment",\n      "soapstone": "Chigware sculptures; Tabaka, Kisii County; world-famous",\n      "pottery": "Historically imported from Luo; local traditions"\n    },\n    "religion": {\n      "traditional": {\n        "supreme_being": "Engoro (autochthonous); Nyasae (Dholuo loanword, now popular)",\n        "attributes": "Monotheistic; creator of Universe; source of life; sun (Risase) and stars important",\n        "theodicy": "Death, disease, crop/livestock destruction = unnatural events caused by evil spirits, bad luck, witchcraft, ancestor spirit displeasure (Ebirecha)",\n        "practitioners": "Medicine men; diviners (omoragori) who identify displeased spirits and prescribe placation",\n        "ancestor_worship": "Veneration of Ebirecha"\n      },\n      "contemporary": {\n        "christian_majority": "Catholicism, Seventh-day Adventist, Swedish Lutheranism, Pentecostal Assemblies of God",\n        "islam_minority": "Small Muslim population",\n        "syncretism": "Traditional religion + Christianity; continued consultation of omoragori",\n        "historical_photos": "Adventist school, Christian Gusii man c. 1916–1938"\n      }\n    }\n  },', 'community': 'kisii', 'section': 'section_8', 'relevance': 1.7418814897537231, 'source': 'Kisii.txt'}]}
