sic beginnings",\n        "Solo-response form",\n        "Chants (recitatives, irregular rhythms)",\n        "Pakruok (mid-performance self-praise chant)",\n        "Sigalagala (ululation, women, climax marker)"\n      ],\n      "instruments": {\n        "percussion": "Drums, clappers, metal rings, ongeng\'o/gara, shakers",\n        "strings": "Nyatiti (8-string lyre), orutu (fiddle)",\n        "wind": "Tung (horn), asili (flute), Abu! (trumpet)"\n      },\n      "dance_style": "Elegant, graceful; leg movement opposite direction with syncopated beat; shoulder shaking to nyatiti",\n      "costumes": {\n        "women": "Owalo (sisal skirts), ombulu/tigo (beads, neck/waist), red/white clay",\n        "men": "Kuodi/chieno (skin from shoulders/waist), ligisa (headgear), shield, spear, reed hats, clubs"\n      },\n      "modern_genres": {\n        "benga": {\n          "origin": "1950s, Luo musicians (George Ramogi, Ochieng\' Kabaselle); adapted traditional rhythms to western/electric guitar",\n          "significance": "Pan-ethnic, one of Africa\'s most popular genres"\n        },\n        "ohangla": "Traditional dance, modernized; associated with Luo weddings, political rallies"\n      },\n      "contemporary_artists": [\n        "Ayub Ogada (nyatiti, Constant Gardener soundtrack)",\n        "Akothee",\n        "Suzanna Owiyo",\n        "Daniel Owino Misiani (benga pioneer)",\n        "Musa Juma",\n        "Tony Nyadundo",\n        "Onyi Papa Jey",\n        "Collela Mazee",\n        "Achieng\' Abura"\n      ]\n    },\n    "kinship_and_inheritance": {\n      "system": "Patrilineal, primogeniture with seniority weighting",\n      "land_division_monogamous": {\n        "first_son": "Center portion, gate to buffer zone",\n        "second_son": "Right hand side",\n        "third_son": "Left hand side",\n        "youngest_son": "Remains in father\'s village, inherits mondo (father\'s personal garden) and mother\'s remaining gardens"\n      },\n      "land_division_polygamous