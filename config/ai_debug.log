o', 'section': 'section_1', 'relevance': 0.8382431268692017, 'source': 'Luo.txt'}, {'content': '\ufeff{\n  "entity_id": "ethnic_group.luo.kenya_tanzania",\n  "entity_name": "Luo",\n  "entity_type": "Ethnic Group",\n  "classification": "Western Nilotic / River-Lake Nilote",\n  "language_family": "Nilotic (Nilo-Saharan)",\n  "branch": "Southern Luo (Kenya/Tanzania)",\n  "autonym": {\n    "person": "Jaluo (m) / Nyaluo (f)",\n    "people": "Joluo",\n    "language": "Dholuo",\n    "homeland": "Piny Luo / Nam Lolwe (Lake Victoria)",\n    "alternative_terms": [\n      "Jonagi/Onagi (refers to removal of six lower teeth as rite of passage)",\n      "Joramogi / Nyikwaramogi (Ramogi\'s heirs)",\n      "Nilotic Kavirondo (colonial designation)"\n    ]\n  },\n  "aliases": [\n    "Joluo",\n    "Nilotic Kavirondo",\n    "Southern Luo",\n    "Ramogi\'s heirs"\n  ],\n  \n  "summary": "The Luo are a Western Nilotic ethnic group native to western Kenya and the Mara Region of northern Tanzania. They are Kenya\'s fourth-largest ethnic group (5.07M, ~10.6% of national population, 2019 census). They form the southernmost extension of the broader Luo peoples, a large ethnolinguistic family spanning South Sudan, Ethiopia, Uganda, Kenya, and Tanzania. Historically a cattle pastoralist, seed farmer, and fishing society, the Luo today are heavily represented in East Africa\'s intellectual, scientific, and professional classes. The community has produced outsized global figures: Barack Obama (44th US President), Lupita Nyong\'o (first black African Academy Award winner), Tom Mboya (Kenyan founding father), and Oginga Odinga (first Vice President). Luo political history is marked by early anti-colonial activism, Cold War-era marginalization, and sustained Kikuyu-Luo rivalry shaping Kenyan multiparty democracy. Culturally, the Luo are originators of benga and ohangla music. Unlike neighboring Nilotes (Kalenjin, Maasai), Luo do not practice male circumcision and historically removed six lower incisors as a distinctive ethnic marker.",', 'community': 'luo', 'section': 'section_0', 'relevance': 1.067518949508667, 'source': 'Luo.txt'}, {'content': '\ufeff{\n  "entity_id": "ethnic_group.luo.kenya_tanzania",\n  "entity_name": "Luo",\n  "entity_type": "Ethnic Group",\n  "classification": "Western Nilotic / River-Lake Nilote",\n  "language_family": "Nilotic (Nilo-Saharan)",\n  "branch": "Southern Luo (Kenya/Tanzania)",\n  "autonym": {\n    "person": "Jaluo (m) / Nyaluo (f)",\n    "people": "Joluo",\n    "language": "Dholuo",\n    "homeland": "Piny Luo / Nam Lolwe (Lake Victoria)",\n    "alternative_terms": [\n      "Jonagi/Onagi (refers to removal of six lower teeth as rite of passage)",\n      "Joramogi / Nyikwaramogi (Ramogi\'s heirs)",\n      "Nilotic Kavirondo (colonial designation)"\n    ]\n  },\n  "aliases": [\n    "Joluo",\n    "Nilotic Kavirondo",\n    "Southern Luo",\n    "Ramogi\'s heirs"\n  ],\n  \n  "summary": "The Luo are a Western Nilotic ethnic group native to western Kenya and the Mara Region of northern Tanzania. They are Kenya\'s fourth-largest ethnic group (5.07M, ~10.6% of national population, 2019 census). They form the southernmost extension of the broader Luo peoples, a large ethnolinguistic family spanning South Sudan, Ethiopia, Uganda, Kenya, and Tanzania. Historically a cattle pastoralist, seed farmer, and fishing society, the Luo today are heavily represented in East Africa\'s intellectual, scientific, and professional classes. The community has produced outsized global figures: Barack Obama (44th US President), Lupita Nyong\'o (first black African Academy Award winner), Tom Mboya (Kenyan founding father), and Oginga Odinga (first Vice President). Luo political history is marked by early anti-colonial activism, Cold War-era marginalization, and sustained Kikuyu-Luo rivalry shaping Kenyan multiparty democracy. Culturally, the Luo are originators of benga and ohangla music. Unlike neighboring Nilotes (Kalenjin, Maasai), Luo do not practice male circumcision and historically removed six lower incisors as a distinctive ethnic marker.",', 'community': 'luo', 'section': 'section_0', 'relevance': 1.067518949508667, 'source': 'Luo.txt'}, {'content': '"geography": {\n    "heartland": "Eastern Lake Victoria basin (Nam Lolwe)",\n    "kenya_regions": {\n      "historical_province": "Nyanza Province (pre-2010)",\n      "current_counties": [\n        "Kisumu",\n        "Siaya",\n        "Homa Bay",\n        "Migori",\n        "Kisii (minority)",\n        "Nairobi (urban migration)"\n      ],\n      "south_nyanza": "Rusinga Island, Mfangano Island, Thimlich Ohinga",\n      "north_nyanza": "Ramogi Hill (first settlement)"\n    },\n    "tanzania_regions": [\n      "Mara Region (Tarime, Musoma, Rorya)"\n    ],\n    "altitude_range": "3700–6000 ft above sea level",\n    "climate": "Tropical, equatorial straddle, average rainfall"\n  },', 'community': 'luo', 'section': 'section_2', 'relevance': 1.1514182090759277, 'source': 'Luo.txt'}]}
